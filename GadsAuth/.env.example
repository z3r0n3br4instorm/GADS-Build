# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Flask session cookie signing key
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# GADS hub port (from installer: HUB_PORT, default 10000)
GADS_PORT=10000

# nginx public port (80 if behind Cloudflare)
NGINX_PORT=80

# ---------------------------------------------------------------------------
# Auth0 application
# ---------------------------------------------------------------------------

AUTH0_DOMAIN=dev-ogoo2r1doi6hafxg.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Must match what you configured in Auth0's Allowed Callback URLs
REDIRECT_URI=https://gads-mac.assurecraft.com/auth/callback

# Where to send users after login
POST_LOGIN_DEFAULT=/

# ---------------------------------------------------------------------------
# GADS JWT configuration (must match "Add New Secret Key" form in GADS)
# ---------------------------------------------------------------------------

GADS_ORIGIN=sso.assurecraft.com
GADS_JWT_SECRET=
GADS_USER_CLAIM=username
GADS_TENANT_CLAIM=tenant
GADS_TENANT_VALUE=assurecraft

# Token TTL in seconds (default 5 min — each subrequest mints a fresh one)
GADS_TOKEN_TTL_SECONDS=300

# Default role and admin emails (comma-separated)
GADS_DEFAULT_ROLE=user
GADS_ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# GADS built-in defaults (auto-generated on first GADS startup)
# ---------------------------------------------------------------------------
# Retrieve with: docker exec gads-mongodb mongosh --quiet --eval \
#   "db.getSiblingDB('gads').secret_keys.findOne({is_default: true}).key"
GADS_DEFAULT_SECRET=

# Retrieve with: docker exec gads-mongodb mongosh --quiet --eval \
#   "db.getSiblingDB('gads').secret_keys.findOne({is_default: true}).tenant"
# Leave empty to use the default GADS tenant
GADS_DEFAULT_TENANT=
