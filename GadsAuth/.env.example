# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
# Flask session cookie signing key
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# GADS hub port (from installer: HUB_PORT, default 10000)
GADS_PORT=10000

# nginx public port (80 if behind Cloudflare)
NGINX_PORT=80

# ---------------------------------------------------------------------------
# Auth0 application
# ---------------------------------------------------------------------------

AUTH0_DOMAIN=dev-ogoo2r1doi6hafxg.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Optional: Leave empty to automatically detect callback URL based on incoming request
# (Works seamlessly across Cloudflare domain, LAN IP, and localhost):
REDIRECT_URI=

# Where to send users after login
POST_LOGIN_DEFAULT=/

# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# GADS JWT configuration (auto-retrieved from MongoDB secret_keys if left empty)
# ---------------------------------------------------------------------------

GADS_ORIGIN=sso.assurecraft.com
# Leave empty to automatically retrieve key for GADS_ORIGIN from MongoDB:
GADS_JWT_SECRET=
GADS_USER_CLAIM=username
GADS_TENANT_CLAIM=tenant
GADS_TENANT_VALUE=assurecraft

# Token TTL in seconds (default 5 min — each subrequest mints a fresh one)
GADS_TOKEN_TTL_SECONDS=300

# Default role and admin emails (comma-separated)
GADS_DEFAULT_ROLE=user
GADS_ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# GADS built-in defaults (auto-retrieved from MongoDB if left empty)
# ---------------------------------------------------------------------------
# Leave empty to automatically retrieve default key from MongoDB:
GADS_DEFAULT_SECRET=
GADS_DEFAULT_TENANT=

# Optional: MongoDB connection URI (default: mongodb://gads-mongodb:27017)
# MONGO_URI=mongodb://gads-mongodb:27017

# Optional: Set to true or false to override automatic Secure cookie policy
# (Default: true if REDIRECT_URI is https://, false if http://)
# SESSION_COOKIE_SECURE=

