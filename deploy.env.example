# Shared settings for every node, used by deploy.sh.
# Copy to deploy.env (gitignored) and fill in. Keep it private: chmod 600 deploy.env
#
# Each deploy merges these into the node's GadsAuth/.env. Empty values are
# skipped, so node-specific values (FLASK_SECRET_KEY, GADS_DEFAULT_SECRET,
# GADS_DEFAULT_TENANT) are kept unless you set them here.

# --- Auth0 (required) ---
AUTH0_DOMAIN=your-tenant.au.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# --- GADS / proxy ---
GADS_ADMIN_EMAILS=admin@example.com
GADS_DEFAULT_ROLE=user
GADS_ORIGIN=sso.assurecraft.com
POST_LOGIN_DEFAULT=/
GADS_PORT=10000
NGINX_PORT=80

# --- Cloudflare (set-tunnel-port.py only; not written to nodes) ---
# API token with: Account > Cloudflare Tunnel > Edit, Zone > DNS > Read
CLOUDFLARE_API_TOKEN=

# --- deploy.sh only (not written to nodes) ---
# Only used when deploy.sh is not run from a git checkout. Otherwise it deploys the
# branch checked out next to it, or the one given with --branch.
DEPLOY_BRANCH=main
DEPLOY_REMOTE_DIR=GADS-Build
